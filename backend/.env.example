MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@your-cluster.mongodb.net/fieldday?retryWrites=true&w=majority
PORT=4000

# Optional: "Sign in with Google". Comma-separated OAuth client IDs (web, iOS
# and Android) from Google Cloud Console. These are public IDs, not secrets.
# If left unset, Google sign-in is rejected by the server.
GOOGLE_CLIENT_IDS=

# Set EMAIL_PROVIDER=ses to send from a verified SES identity using the
# server's AWS role. For production the SES account must leave the sandbox.
EMAIL_PROVIDER=
AWS_REGION=us-east-2
SES_FROM=

# Optional SMTP alternative. In development without a sender, codes are logged;
# in production missing sender configuration is an error, not a logged code.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional Gorse recommendation service. For local Compose, keep the URL on
# localhost and leave GORSE_API_KEY blank. For a remote service, use HTTPS and
# store its API key and this stable HMAC secret in the backend secret store.
GORSE_BASE_URL=http://127.0.0.1:8088
GORSE_API_KEY=
GORSE_ID_SECRET=
