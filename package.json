{
  "name": "FieldDay",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "sbom": "cyclonedx-npm --ignore-npm-errors --omit dev --workspace backend --workspace frontend --include-workspace-root --gather-license-texts --output-reproducible --spec-version 1.6 --output-format JSON --output-file doc/SBOM.json --validate && node scripts/complete-sbom-metadata.mjs",
    "test:logger": "node test-logger.js",
    "test:unit": "node --test \"backend/test/unit/*.test.js\"",
    "build": "npm run build --workspace frontend",
    "check:backend": "node scripts/check-backend.mjs",
    "check": "node scripts/check.mjs",
    "test:integration": "npm run test:integration --workspace backend",
    "test:chat": "npm run test:chat --workspace backend",
    "test:accounts": "npm run test:accounts --workspace backend",
    "test:sport-preferences": "node scripts/test-sport-preferences.mjs",
    "test:session-lifecycle": "node scripts/test-session-lifecycle.mjs",
    "test:realtime": "node scripts/test-realtime.mjs",
    "test:cooldown": "node scripts/test-cooldown.mjs",
    "test:session-membership": "node scripts/test-session-membership.mjs",
    "test:session-visibility": "node scripts/test-session-visibility.mjs",
    "test:authorization": "node scripts/test-authorization.mjs",
    "test:profile-setup": "node scripts/test-profile-setup.mjs",
    "test:attendance": "node scripts/test-attendance-and-host-changes.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "export:shaped": "node backend/scripts/export-shaped-data.mjs",
    "test:shaped-export": "node scripts/test-shaped-export.mjs",
    "postinstall": "patch-package",
    "simulate:local": "node scripts/simulate-local.mjs"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@eslint/js": "^9.39.5",
    "@react-native/eslint-config": "^0.87.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.15.0",
    "glob": "14.0.4",
    "minimatch": "11.0.5",
    "patch-package": "^8.0.1",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "proxy-addr": "^2.0.8",
    "shell-quote": "^1.12.0",
    "winston": "^3.19.0"
  },
  "overrides": {
    "@expo/cli": {
      "glob": "$glob"
    },
    "@expo/config": {
      "glob": "$glob"
    },
    "@expo/config-plugins": {
      "glob": "$glob"
    },
    "@expo/fingerprint@0.21.8": {
      "glob": "$glob"
    },
    "@expo/metro-config": {
      "glob": "$glob"
    },
    "minimatch@^10.2.2": "$minimatch",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "10.2.6"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.21"
    }
  }
}
