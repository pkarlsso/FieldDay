{
  "name": "FieldDay",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:logger": "node test-logger.js",
    "build": "npm run build --workspace frontend",
    "check:backend": "node scripts/check-backend.mjs",
    "check": "node scripts/check.mjs",
    "test:integration": "node scripts/integration-session.mjs",
    "test:accounts": "node scripts/integration-accounts.mjs",
    "test:sport-preferences": "node scripts/test-sport-preferences.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "export:shaped": "node backend/scripts/export-shaped-data.mjs",
    "test:shaped-export": "node scripts/test-shaped-export.mjs",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@react-native/eslint-config": "^0.87.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.15.0",
    "typescript-eslint": "^8.70.0",
    "patch-package": "^8.0.1"
  },
  "dependencies": {
    "winston": "^3.19.0"
  }
}
