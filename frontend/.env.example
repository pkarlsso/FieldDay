# Native Apple map is the default for local iOS simulator testing.
EXPO_PUBLIC_MAP_PROVIDER=apple
EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_IP:4000/graphql

# Optional: "Continue with Google" buttons. Set the client ID for each platform
# you run on (these must also be listed in the backend's GOOGLE_CLIENT_IDS).
# The buttons stay hidden while the ID for the current platform is empty.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Use Google provider only after adding a Google Maps iOS key to a native build.
# EXPO_PUBLIC_MAP_PROVIDER=google
