{
  "expo": {
    "name": "FieldDay",
    "slug": "fieldday",
    "owner": "gogbalor",
    "extra": {
      "eas": {
        "projectId": "dd004d66-cf1c-41a0-823f-64efc93b48f7"
      }
    },
    "scheme": "fieldday",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FieldDay uses your location to show nearby sport sessions on the map and to check you in when you arrive at a session.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.gogbalor.fieldday"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.487036458278-d4mb997n2e93p7a67rjnv7dsrak3ev92"
        }
      ],
      "expo-status-bar",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "FieldDay uses your photo library so you can choose a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/withQuotedReactNativeXcodeScript",
      "expo-build-properties"
    ]
  }
}
